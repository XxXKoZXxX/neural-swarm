# ── Sentinel (Node, server-side only) ─────────────────────────────────────────
GITHUB_TOKEN=ghp_your_token_here
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Frontend (Vite — these are bundled into the client, never put secrets here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_SWARM_PROXY_URL=https://your-project.supabase.co/functions/v1/swarm-proxy

# ── Supabase Edge Functions (set with `supabase secrets set`) ─────────────────
# ANTHROPIC_KEY=sk-ant-...
# ALLOWED_ORIGINS=https://neural-swarm.vercel.app,http://localhost:5173
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_POWER=price_...
# FRONTEND_URL=https://neural-swarm.vercel.app
